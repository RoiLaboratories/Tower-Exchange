{
  "name": "@tower-finance/contracts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "deploy": "hardhat run scripts/deploy.ts",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network arc-testnet",
    "deploy:xylonet-adapter": "hardhat run scripts/deploy-xylonet-adapter.cjs --network arc-testnet",
    "deploy:recurring-order-executor": "hardhat run scripts/deploy-recurring-order-executor.cjs --network arc-testnet",
